{
  "version": 2,
  "builds": [
    {
      "src": "packages/server/src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["packages/server/build/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "packages/server/src/server.ts"
    }
  ]
}