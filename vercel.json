{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build:server",
  "outputDirectory": "packages/server/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "packages/server/build/index.js"
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18.x"
    }
  }
}